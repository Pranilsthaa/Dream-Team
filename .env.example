# Base URL includes /api. Copy to .env.local for local overrides.
# localhost on Android requires: adb -s <serial> reverse tcp:3001 tcp:3001
# Android emulator without reverse: http://10.0.2.2:3001/api
# Physical device over Wi-Fi: http://<computer-LAN-IP>:3001/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api
